{
  "theme": "dark",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "packages": ["npm:pi-sandbox@0.6.8"],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  }
}
